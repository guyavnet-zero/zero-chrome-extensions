{
  "name": "zero-dashboard",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postinstall": "node -e \"const f='node_modules/@crxjs/vite-plugin/dist/index.mjs';const fs=require('fs');if(fs.existsSync(f)){const s=fs.readFileSync(f,'utf8');const p=s.replace('matches: [\\\"<all_urls>\\\"]','matches: [\\\"https://*.zeronetworks.com/*\\\"]');if(p!==s)fs.writeFileSync(f,p);}\""
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.5.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
